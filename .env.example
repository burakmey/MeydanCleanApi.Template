# =============================================================================
# Settings for Docker. Used by docker-compose.yml only.
#
# Copy this file to ".env" in the same folder:   cp .env.example .env
#
# ".env" holds your real passwords and keys. It is never committed to git.
# This ".env.example" file has fake values and is safe to commit.
# =============================================================================
#
# The start of each name tells you who uses it:
#
#   COMPOSE_   docker-compose.yml itself, for port numbers
#   DB_        the PostgreSQL container, and the API's connection string
#   API_       the API container only
#   PGADMIN_   the optional pgAdmin container only
#
# =============================================================================


# -- Ports on your computer ---------------------------------------------------
# Change one of these if something else is already using that port.

COMPOSE_API_PORT=5080
COMPOSE_PGADMIN_PORT=5050

# 5433, not 5432, so this container and a PostgreSQL installed on your computer
# can both run at the same time.
COMPOSE_DB_PORT=5433


# -- Database -----------------------------------------------------------------
# Used twice: to create the PostgreSQL container, and to build the connection
# string the API uses. One place to change, so the two can never disagree.
#
# This database lives only inside Docker. It starts empty, and the API creates
# the tables the first time it runs.

DB_NAME=meydanclean_db
DB_USER=postgres
DB_PASSWORD=postgres


# -- API: which mode to run in ------------------------------------------------
# Development shows Swagger at /swagger and adds sample data.
# Production hides Swagger and turns on stricter security.
API_ENVIRONMENT=Development


# -- API: JWT keys (REQUIRED) -------------------------------------------------
# Docker will not start without these two.
#
# The values below are only for your own computer. Make real ones before anyone
# else uses this:
#
#   openssl rand -base64 48
#
# Must be at least 32 characters. Shorter keys are rejected.
API_JWT_ACCESS_KEY=Docker_Local_JwtSecurityKey_Minimum_32_Chars_Long_Key!
API_JWT_REFRESH_KEY=Docker_Local_RefreshSecurityKey_Minimum_32_Chars_Long_Key!

# Signs the upload and download links the API hands out for files kept on local
# disk. A cloud provider signs its own links; local disk has nobody to do that,
# so the API does it with this key. Uploads are refused while it is empty.
# Make a real one the same way as the two above.
API_STORAGE_SIGNING_KEY=Docker_Local_StorageSigningKey_Minimum_32_Chars_Long_Key!
API_STORAGE_URL_EXPIRY_MINUTES=15

API_JWT_ISSUER=MeydanCleanApi
API_JWT_AUDIENCE=MeydanCleanApi.Clients
API_JWT_ACCESS_MINUTES=15
API_JWT_REFRESH_DAYS=7


# -- API: which websites may call the API -------------------------------------
# Put the address your front end runs on. appsettings.json has an empty list, so
# without these a website in a browser cannot call the API at all.
API_CORS_ORIGIN_0=http://localhost:3000
API_CORS_ORIGIN_1=http://localhost:5173


# -- API: first admin user ----------------------------------------------------
# Leave both empty to skip this. The user is only created when the users table
# is completely empty, so it never replaces an account you already have.
#
# The password needs 8 or more characters, with a capital letter, a small letter,
# a number and a symbol.
API_SEED_ADMIN_EMAIL=admin@example.com
API_SEED_ADMIN_PASSWORD=Adm1n!Local_2026


# -- API: Supabase file storage (optional) ------------------------------------
# Leave empty to save files on disk instead. That is the default and needs no
# account. Fill these in only when you want to try Supabase.
#
# Empty values are safe: Supabase is only set up when something asks for it, so
# everything else keeps working.
API_SUPABASE_URL=
API_SUPABASE_API_KEY=
API_SUPABASE_BUCKET=uploads
API_SUPABASE_URL_EXPIRY_MINUTES=60


# -- API: Google sign-in (optional) -------------------------------------------
# Empty means Google sign-in is off. Email and password login still works.
API_GOOGLE_CLIENT_ID=


# -- pgAdmin (optional) -------------------------------------------------------
# Start it with:  docker compose --profile tools up -d
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=pgadmin
